# ========== DeepSeek LLM（文案 / 主题）==========
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
# 可选：回炉等轻量调用
# LLM_MODEL_LIGHT=deepseek-chat

# ========== 页面打分 VL（Puppeteer 截图 → 视觉模型）==========
# 推荐阿里云百炼 DashScope OpenAI 兼容接口 + qwen-vl-max
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 也可单独写（优先于 DASHSCOPE_API_KEY）：
# SCORE_VL_API_KEY=sk-your-dashscope-key
SCORE_VL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 或：DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SCORE_VL_MODEL=qwen-vl-max
# 关闭打分回炉：AGENT_PAGE_SCORE=0
# 关闭 DOM 测高：AGENT_GATE_DOM=0
# 强制 mock（不调真实 API）：AGENT_MOCK=1
# Chrome 路径（可选，Puppeteer 找不到浏览器时）：
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ========== 自定义文生图（gpt-image-2 协议）==========
# IMAGE_API_BASE_URL = 完整 POST 地址（不要只写域名）
IMAGE_API_PROVIDER=custom
IMAGE_API_BASE_URL=https://你的域名/生图接口路径
IMAGE_API_KEY=你的生图apikey
IMAGE_MODEL=gpt-image-2
# 画布 16:9 可试 1792x1024 / 1024x1024，按服务商文档填
IMAGE_ASPECT_RATIO=1024x1024

# 若要用 OpenAI 官方生图：
# IMAGE_API_PROVIDER=openai
# IMAGE_API_BASE_URL=https://api.openai.com/v1
# IMAGE_MODEL=dall-e-3
